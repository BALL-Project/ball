<!--
  Phase 999.40 + 999.41 — BALLView Refresh theme + icon resource bundle.

  Per maintainer-Q3 (`.planning/MAINTAINER-QUESTIONS-999.1.md`):
    SINGLE NEUTRAL THEME ONLY — no light/dark/follow-system variants.

  The ThemeManager singleton loads the stylesheet via the alias path
  `:/theme/theme-neutral.qss` at app startup (gated on BALL_UI_V2).

  Phase 999.41 (SVG icons + HiDPI): the `/icons` prefix exposes the
  vendored Lucide v0.460.0 subset under BALLView's existing icon-key
  naming convention (`actions/<name>.svg`, `categories/<name>.svg`).
  Aliases map each BALLView key to the Lucide source file in
  `icons/lucide/`, so `IconLoader::loadIcon_` only has to try the
  resource path `:/icons/<name>.svg` — no per-name C++ mapping
  required. See `iconLoader.C` for the SVG-preferred lookup wedge.

  Multi-aliasing (e.g. quicksave + document-save both → save.svg) is
  intentional: BALLView calls them by distinct keys but visually they
  should be the same glyph under the v1.7 design language.
-->
<RCC>
    <qresource prefix="/theme">
        <file alias="theme-neutral.qss">theme-neutral.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <!-- BALLView "actions/*" namespace -->
        <file alias="actions/quickopen-file.svg">icons/lucide/folder-open.svg</file>
        <file alias="actions/quicksave.svg">icons/lucide/save.svg</file>
        <file alias="actions/document-save.svg">icons/lucide/save.svg</file>
        <file alias="actions/view-fullscreen.svg">icons/lucide/maximize.svg</file>
        <file alias="actions/view-restore.svg">icons/lucide/minimize-2.svg</file>
        <file alias="actions/process-stop.svg">icons/lucide/octagon-x.svg</file>
        <file alias="actions/measure.svg">icons/lucide/ruler.svg</file>
        <file alias="actions/list-add.svg">icons/lucide/plus.svg</file>
        <file alias="actions/edit-delete.svg">icons/lucide/trash-2.svg</file>
        <file alias="actions/edit-copy.svg">icons/lucide/copy.svg</file>
        <!-- v1.7.0-rc3 UFG-16: swapped atom.svg → droplets.svg. The atom
             glyph (electron-orbital styling) reads as "atom/molecule" — a
             noun, not the additive operation users expect on the "Add
             Hydrogens" toolbar slot. droplets.svg has the cleanest
             chemistry/water-H semantic association in the Lucide v0.460.0
             catalog; atom.svg remains vendored in case a composed
             atom-plus-badge glyph lands later as v1.7.1 polish. -->
        <file alias="actions/molecule-add-hydrogens.svg">icons/lucide/droplets.svg</file>
        <!-- v1.7.0-rc2 UFG-14 polish: swapped shrink.svg → target.svg. The
             "shrink" glyph reads as scale-down (UI gesture) but the actual
             semantic is energy-minimize (find the lowest-energy
             conformation). target.svg ("converge to optimum") is the
             closest semantic fit in the Lucide v0.460.0 catalog. -->
        <file alias="actions/molecule-minimize.svg">icons/lucide/target.svg</file>
        <file alias="actions/molecule-assign-bond-orders.svg">icons/lucide/link-2.svg</file>
        <!-- BALLView "categories/*" namespace -->
        <file alias="categories/preferences.svg">icons/lucide/settings.svg</file>
        <!-- Spare: available for future tooltip/help affordances -->
        <file alias="actions/help-hint.svg">icons/lucide/help-circle.svg</file>
        <!-- Phase 999.42: paired with the XPM-array removal in
             mainframe.C / mainControl.C / serverWidget.C. ball-app is
             a placeholder; the bespoke app-icon artwork ships via
             Phase 8 packaging (see ball-app.svg header for details). -->
        <file alias="ball-app.svg">icons/lucide/ball-app.svg</file>
        <file alias="actions/simulation-running.svg">icons/lucide/activity.svg</file>
        <file alias="actions/raytracing.svg">icons/lucide/zap.svg</file>
        <!-- Phase 999.43: shared-widget chevrons (SectionHeader) + reset
             glyph (LabeledSlider). chevron-* used by the section header's
             expand/collapse toggle; rotate-ccw aliased as 'actions/reset'
             for the slider's revert-to-default button. -->
        <file alias="actions/chevron-down.svg">icons/lucide/chevron-down.svg</file>
        <file alias="actions/chevron-right.svg">icons/lucide/chevron-right.svg</file>
        <file alias="actions/reset.svg">icons/lucide/rotate-ccw.svg</file>
        <!-- Phase 999.45: chevron-up paired with the existing chevron-down.
             Used by BottomDrawer (24px↔240px collapsed/expanded toggle). -->
        <file alias="actions/chevron-up.svg">icons/lucide/chevron-up.svg</file>
        <!-- v1.7.0-rc2 UFG-01: toolbar slots that were rendering blank in
             rc1. These wire the BALLView dialogs' addToolBarEntries icons
             (file-open, PDB / Electron-Density / PubChem downloads, display
             properties, focus camera) through to vendored Lucide glyphs.
             See LICENSE-lucide.txt for the v0.460.0 provenance + the
             extended vendored subset list. -->
        <file alias="actions/document-open.svg">icons/lucide/folder-open.svg</file>
        <file alias="actions/download-pdb.svg">icons/lucide/download.svg</file>
        <file alias="actions/download-electrondensity.svg">icons/lucide/cloud-download.svg</file>
        <file alias="actions/download-pubchem.svg">icons/lucide/flask-conical.svg</file>
        <file alias="categories/preferences-display.svg">icons/lucide/monitor.svg</file>
        <file alias="actions/object-focus.svg">icons/lucide/focus.svg</file>
        <!-- v1.7.0-rc2 UFG-01: edit-mode + scene secondary toolbars. The
             edit mode is hidden behind a debug-flag in shipping builds but
             the actions are constructed unconditionally; missing icons
             would surface as blank slots when the toolbar is exposed. -->
        <file alias="actions/mode-edit.svg">icons/lucide/pencil.svg</file>
        <file alias="actions/molecule-set-element.svg">icons/lucide/tag.svg</file>
        <file alias="actions/create-bond.svg">icons/lucide/link.svg</file>
        <file alias="actions/continuous-loop.svg">icons/lucide/repeat.svg</file>
        <file alias="actions/screenshot.svg">icons/lucide/camera.svg</file>
        <!-- v1.7.0-rc2 UFG-14: interaction-mode toolbar buttons (Scene
             toolbar — select-rectangular, transform-move, transform-rotate)
             were rendering blank in rc2. These actions are constructed
             unconditionally during Scene initialization, so the missing
             icons surfaced as blank slots on the main scene toolbar for
             every user. See pickingMode.C:28, moveMode.C:51,
             rotateMode.C:30. -->
        <file alias="actions/select-rectangular.svg">icons/lucide/square-dashed-mouse-pointer.svg</file>
        <file alias="actions/transform-move.svg">icons/lucide/move.svg</file>
        <file alias="actions/transform-rotate.svg">icons/lucide/rotate-3d.svg</file>
        <!-- NOTE: scene.C also references 'mimetype/text-x-povray' but that
             action is menu-only (add_to_main_toolbar=false in setIcon
             call). Resolution deferred — POV-Ray output is rare and the
             menu entry remains usable without a glyph. -->
    </qresource>
</RCC>
