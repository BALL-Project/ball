<?xml version="1.0" encoding="utf-8"?>
<!--
  BALLView macOS auto-update appcast.

  Phase 999.8-full. Hosted at:
    https://ball-project.github.io/ball/appcast-macos.xml
  via the `gh-pages` branch of BALL-Project/ball (see
  .planning/phases/999.8-auto-update-sparkle-winsparkle/APPCAST-PUBLISHING-RUNBOOK.md).

  CI's publish-appcast job (release.yml) appends a new <item> on each tagged
  release and pushes the updated XML to gh-pages. Manual edits to this file
  are uncommon — the file lives in the repo as a template and as the
  initial seed when gh-pages is first populated.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>BALLView macOS Updates</title>
    <link>https://ball-project.github.io/ball/appcast-macos.xml</link>
    <description>BALLView molecular visualization — macOS auto-update feed.</description>
    <language>en</language>

    <!-- Template entry — replaced by publish-appcast on first signed release.
         Sparkle ignores entries whose sparkle:version is <= the running
         app's CFBundleVersion, so this template is a no-op for installed
         users of v1.7.0+.
    -->
    <item>
      <title>BALLView 1.7.0 (template — replaced on first release)</title>
      <pubDate>Sun, 17 May 2026 12:00:00 +0000</pubDate>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:releaseNotesLink>
        https://github.com/BALL-Project/ball/releases/tag/v1.7.0
      </sparkle:releaseNotesLink>
      <enclosure
        url="https://github.com/BALL-Project/ball/releases/download/v1.7.0/BALLView-v1.7.0-macos-arm64.dmg"
        sparkle:version="1.7.0"
        sparkle:os="macos"
        length="0"
        type="application/octet-stream"
        sparkle:edSignature="PLACEHOLDER_REPLACED_BY_PUBLISH_APPCAST_JOB" />
    </item>
  </channel>
</rss>
